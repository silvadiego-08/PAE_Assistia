<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" style="-fx-font-size: 16px;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.assistia.controller.MedicamentoController">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <Label text="Catálogo de medicamentos" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <Label text="RxNorm solo completa el nombre. Revisa y completa principio activo, presentación y concentración antes de guardar."
           wrapText="true" style="-fx-text-fill: #666;"/>

    <TitledPane fx:id="panelBusqueda" text="Buscar en RxNorm (clic para abrir)" expanded="false">
        <VBox spacing="8">
            <HBox fx:id="barraBusqueda" spacing="10">
                <TextField fx:id="txtBuscar" promptText="Ej. azithromycin"
                           onAction="#onBuscar" HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnBuscar" text="Buscar en línea" onAction="#onBuscar"/>
            </HBox>
            <Label fx:id="lblEstadoBusqueda" wrapText="true"
                   style="-fx-text-fill: #555;"/>
            <TableView fx:id="tablaResultados" prefHeight="130">
                <columns>
                    <TableColumn fx:id="colResultadoNombre" text="Nombre en RxNorm" prefWidth="520"/>
                    <TableColumn fx:id="colResultadoRxcui" text="RxCUI" prefWidth="110"/>
                </columns>
            </TableView>
            <Button fx:id="btnUsarResultado" text="Usar resultado"
                    onAction="#onUsarResultado"/>
        </VBox>
    </TitledPane>

    <GridPane hgap="10" vgap="8">
        <columnConstraints>
            <ColumnConstraints minWidth="180"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Nombre *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre" promptText="Ej. Paracetamol" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Principio activo *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPrincipioActivo" promptText="Ej. Paracetamol" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Presentación *" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPresentacion" promptText="Ej. Tableta" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Concentración *" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtConcentracion" promptText="Ej. 500 mg" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox fx:id="barraAcciones" spacing="10">
        <Button text="Guardar" onAction="#onGuardar"/>
        <Button text="Actualizar" onAction="#onActualizar"/>
        <Button text="Eliminar" onAction="#onEliminar"/>
        <Button text="Limpiar" onAction="#onLimpiar"/>
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="220"/>
            <TableColumn fx:id="colPrincipio" text="Principio activo" prefWidth="220"/>
            <TableColumn fx:id="colPresentacion" text="Presentación" prefWidth="160"/>
            <TableColumn fx:id="colConcentracion" text="Concentración" prefWidth="160"/>
        </columns>
    </TableView>
</VBox>
