<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.assistia.controller.MedicoController" spacing="18" styleClass="module-page">
    <VBox spacing="5">
        <Label text="Médicos" styleClass="page-title"/>
        <Label text="Consulta y actualiza el catálogo de profesionales de salud." styleClass="muted" wrapText="true"/>
    </VBox>
    <VBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox spacing="13" styleClass="panel">
            <Label text="Datos del registro" styleClass="section-title"/>
            <GridPane hgap="18" vgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Nombre" styleClass="field-label"/>
                    <TextField fx:id="txtNombre" promptText="Nombre completo" accessibleText="Nombre"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Especialidad" styleClass="field-label"/>
                    <TextField fx:id="txtEspecialidad" promptText="Ej. Geriatría" accessibleText="Especialidad"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Teléfono (opcional)" styleClass="field-label"/>
                    <TextField fx:id="txtTelefono" promptText="Número de teléfono" accessibleText="Teléfono (opcional)"/>
                </VBox>
            </GridPane>
            <HBox fx:id="barraAcciones" spacing="10" styleClass="actions">
                <Button text="Guardar" onAction="#onGuardar" styleClass="primary-button"/>
                <Button text="Actualizar" onAction="#onActualizar" styleClass="secondary-button"/>
                <Button text="Limpiar" onAction="#onLimpiar" styleClass="secondary-button"/>
                <Button text="Eliminar" onAction="#onEliminar" styleClass="danger-button"/>
            </HBox>
        </VBox>
        <VBox spacing="9" styleClass="panel" VBox.vgrow="ALWAYS">
            <Label text="Lista de médicos" styleClass="section-title"/>
            <TableView fx:id="tabla" minHeight="220" prefHeight="270" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="235" minWidth="160"/>
                    <TableColumn fx:id="colEspecialidad" text="Especialidad" prefWidth="200" minWidth="150"/>
                    <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="150" minWidth="100"/>
                </columns>
                <placeholder><Label text="No hay médicos para mostrar." styleClass="muted" wrapText="true"/></placeholder>
            </TableView>
        </VBox>
    </VBox>
</VBox>
