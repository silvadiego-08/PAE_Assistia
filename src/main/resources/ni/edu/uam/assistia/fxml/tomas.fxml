<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.assistia.controller.RegistroTomaController"
      fx:id="pagina" spacing="18" styleClass="module-page">
    <Label text="Registro de tomas" styleClass="page-title"/>

    <VBox spacing="12" styleClass="panel">
        <HBox spacing="12" alignment="BOTTOM_LEFT">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Paciente" styleClass="field-label"/>
                <ComboBox fx:id="paciente" promptText="Selecciona un paciente" maxWidth="Infinity"
                          accessibleText="Paciente"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Día de consulta" styleClass="field-label"/>
                <DatePicker fx:id="diaConsulta" editable="false" accessibleText="Día de consulta"/>
            </VBox>
            <Button text="Recargar" onAction="#recargar" styleClass="secondary-button"/>
        </HBox>
        <TableView fx:id="tabla" prefHeight="220" accessibleText="Tomas del día">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colMedicamento" text="Medicamento" prefWidth="140"/>
                <TableColumn fx:id="colProgramada" text="Programada" prefWidth="140"/>
                <TableColumn fx:id="colRealizada" text="Realizada" prefWidth="140"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="80"/>
                <TableColumn fx:id="colObservacion" text="Observación" prefWidth="130"/>
            </columns>
            <placeholder>
                <Label text="Selecciona un paciente o consulta otro día." styleClass="muted"/>
            </placeholder>
        </TableView>
        <Button fx:id="btnRealizada" text="Marcar realizada" onAction="#marcarRealizada"
                styleClass="secondary-button"/>
    </VBox>

    <VBox spacing="12" styleClass="panel">
        <Label text="Programación" styleClass="section-title"/>
        <VBox spacing="5">
            <Label text="Medicamento del tratamiento" styleClass="field-label"/>
            <ComboBox fx:id="medicamento" promptText="Selecciona un medicamento" maxWidth="Infinity"
                      accessibleText="Medicamento del tratamiento"/>
        </VBox>
        <HBox spacing="12">
            <VBox spacing="5">
                <Label text="Fecha programada" styleClass="field-label"/>
                <DatePicker fx:id="fechaProgramada" editable="false" accessibleText="Fecha programada"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Hora (24 horas)" styleClass="field-label"/>
                <TextField fx:id="horaProgramada" promptText="08:30" prefColumnCount="6"
                           accessibleText="Hora programada"/>
            </VBox>
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Observación (opcional)" styleClass="field-label"/>
                <TextField fx:id="observacion" accessibleText="Observación de una toma nueva"/>
            </VBox>
        </HBox>
        <HBox spacing="12">
            <Button fx:id="btnProgramar" text="Programar toma" onAction="#programar"
                    styleClass="primary-button"/>
            <Button fx:id="btnReprogramar" text="Cambiar horario de la toma seleccionada"
                    onAction="#reprogramar" styleClass="secondary-button"/>
        </HBox>
        <Label fx:id="mensaje" wrapText="true" styleClass="muted"/>
    </VBox>
</VBox>
