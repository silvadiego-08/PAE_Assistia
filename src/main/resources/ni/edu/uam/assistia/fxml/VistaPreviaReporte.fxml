<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.assistia.controller.VistaPreviaReporteController"
            stylesheets="@../css/assistia.css"
            styleClass="assistia, vista-reporte"
            prefWidth="1000"
            prefHeight="750">

    <top>

        <HBox alignment="CENTER"
              spacing="12"
              styleClass="barra-herramientas">

            <padding>
                <Insets top="15" bottom="15"
                        left="15" right="15"/>
            </padding>

            <Button fx:id="anterior"
                    text="Anterior"
                    onAction="#paginaAnterior"/>

            <Label fx:id="indicadorPagina"
                   text="Página 1 de 1"/>

            <Button fx:id="siguiente"
                    text="Siguiente"
                    onAction="#paginaSiguiente"/>

            <Button text="-"
                    onAction="#reducirZoom"/>

            <Label fx:id="indicadorZoom"
                   text="100%"/>

            <Button text="+"
                    onAction="#ampliarZoom"/>

        </HBox>

    </top>

    <center>

        <ScrollPane fitToWidth="true"
                    pannable="true"
                    styleClass="visor-reporte">

            <content>

                <VBox alignment="TOP_CENTER"
                      styleClass="contenedor-hoja">

                    <padding>
                        <Insets top="25" bottom="25"
                                left="25" right="25"/>
                    </padding>

                    <ImageView fx:id="imagenReporte"
                               preserveRatio="true"
                               smooth="true"/>

                </VBox>

            </content>

        </ScrollPane>

    </center>

    <bottom>

        <HBox alignment="CENTER_RIGHT"
              spacing="12"
              styleClass="barra-acciones">

            <padding>
                <Insets top="15" bottom="15"
                        left="15" right="15"/>
            </padding>

            <Button fx:id="descargarPdf"
                    text="Descargar PDF"
                    styleClass="boton-pdf"
                    onAction="#exportarPdf"/>

            <Button fx:id="descargarExcel"
                    text="Descargar Excel"
                    styleClass="boton-excel"
                    onAction="#exportarExcel"/>

            <Button text="Cerrar"
                    styleClass="boton-cerrar"
                    onAction="#cerrar"/>

        </HBox>

    </bottom>

</BorderPane>